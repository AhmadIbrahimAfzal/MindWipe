<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Bubbly Count Badge -->
        <TextView
            android:id="@+id/widget_pending_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 THOUGHTS FLOATING"
            android:textColor="#8E8E93"
            android:textSize="10sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Rotating Task Flipper with Smooth Slide-Up & Fade Transition -->
        <ViewFlipper
            android:id="@+id/widget_task_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:inAnimation="@anim/widget_task_slide_in"
            android:outAnimation="@anim/widget_task_slide_out"
            android:autoStart="true"
            android:flipInterval="3500">

            <TextView
                android:id="@+id/widget_top_task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dump a thought..."
                android:textColor="#F2F2F7"
                android:textSize="17sp"
                android:fontFamily="sans-serif-rounded"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </ViewFlipper>
    </LinearLayout>

    <!-- Bubbly Circular Add Button -->
    <LinearLayout
        android:id="@+id/widget_add_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#F2F2F7"
            android:textSize="24sp"
            android:fontFamily="sans-serif-rounded"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
